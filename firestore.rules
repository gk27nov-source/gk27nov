rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get user record to check organization and role safely
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function getUserRole() {
      let u = getUserData();
      return u != null && 'role' in u ? u.role : 'super_admin';
    }

    function getUserOrgId() {
      let u = getUserData();
      return u != null && 'organizationId' in u ? u.organizationId : 'org_smart_hub_01';
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }
    
    function isBusinessAdmin(orgId) {
      return isAuthenticated() && (
        getUserRole() == 'super_admin' || 
        (getUserOrgId() == orgId && getUserRole() == 'business_admin')
      );
    }
    
    function isSameOrg(orgId) {
      return isAuthenticated() && (
        getUserRole() == 'super_admin' || 
        getUserOrgId() == orgId
      );
    }
    
    function isViewer() {
      return isAuthenticated() && getUserRole() == 'viewer';
    }

    // Organizations collection
    match /organizations/{orgId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || getUserOrgId() == orgId);
      allow create: if isAuthenticated();
      allow update, delete: if isBusinessAdmin(orgId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || 
        isBusinessAdmin(resource.data.organizationId)
      );
      allow delete: if isAuthenticated() && isBusinessAdmin(resource.data.organizationId);
    }

    // Tenant-isolated collections
    match /{collectionName}/{docId} {
      allow read: if isAuthenticated() && (
        collectionName in ['customers', 'leads', 'complaints', 'tasks', 'documents', 'communications', 'notifications', 'automations', 'automationLogs', 'settings', 'activityLogs', 'quotations', 'invoices', 'products', 'categories', 'stores', 'suppliers', 'stockTransactions', 'stockTransfers', 'purchaseOrders', 'goodsReceipts', 'stockReservations', 'stockAudits', 'stockAdjustments'] &&
        (resource == null || isSameOrg(resource.data.organizationId))
      );
      
      allow create: if isAuthenticated() && 
        collectionName in ['customers', 'leads', 'complaints', 'tasks', 'documents', 'communications', 'notifications', 'automations', 'automationLogs', 'settings', 'activityLogs', 'quotations', 'invoices', 'products', 'categories', 'stores', 'suppliers', 'stockTransactions', 'stockTransfers', 'purchaseOrders', 'goodsReceipts', 'stockReservations', 'stockAudits', 'stockAdjustments'] &&
        !isViewer() &&
        (request.resource.data.organizationId == getUserOrgId() || isSuperAdmin());
        
      allow update: if isAuthenticated() &&
        collectionName in ['customers', 'leads', 'complaints', 'tasks', 'documents', 'communications', 'notifications', 'automations', 'automationLogs', 'settings', 'activityLogs', 'quotations', 'invoices', 'products', 'categories', 'stores', 'suppliers', 'stockTransfers', 'purchaseOrders', 'goodsReceipts', 'stockReservations', 'stockAudits', 'stockAdjustments'] &&
        !isViewer() &&
        isSameOrg(resource.data.organizationId) &&
        request.resource.data.organizationId == resource.data.organizationId;
        
      allow delete: if isAuthenticated() &&
        collectionName in ['customers', 'leads', 'complaints', 'tasks', 'documents', 'communications', 'notifications', 'automations', 'automationLogs', 'settings', 'activityLogs', 'quotations', 'invoices', 'products', 'categories', 'stores', 'suppliers', 'stockTransfers', 'purchaseOrders', 'goodsReceipts', 'stockReservations', 'stockAudits', 'stockAdjustments'] &&
        !isViewer() &&
        (isBusinessAdmin(resource.data.organizationId) || getUserRole() == 'manager');
    }
  }
}
