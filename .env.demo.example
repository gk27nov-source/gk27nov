# Build-time flag for the DEMO build only.
#
# VITE_DEMO_MODE=true restores the one-click role personas and the navbar role
# switcher — both bypass authentication entirely. Use it for a live walkthrough,
# never for the published app.
#
#   Demo:        VITE_DEMO_MODE=true npm run build
#   Production:  npm run build
#
# Vite inlines this at build time and strips the dead branch, so with the flag
# off the bypass code is absent from the bundle rather than merely hidden.
VITE_DEMO_MODE=true
