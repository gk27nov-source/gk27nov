# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# N8N_INCOMING_SECRET: shared secret for POST /api/webhooks/n8n/incoming.
# The endpoint is DISABLED (503) until this is set — it fails closed, not open.
# Generate with: openssl rand -hex 32
N8N_INCOMING_SECRET=""

# ---------------------------------------------------------------------------
# n8n dispatch — Phase 2. The browser no longer sends a webhook URL it can
# choose freely, and never sends a credential. These control both.
# ---------------------------------------------------------------------------

# Master switch. false makes the dispatch endpoint refuse everything.
N8N_ENABLED="true"

# Default destination when a rule has none. Must be an ACTIVATED workflow's
# /webhook/ url — /webhook-test/ is refused, it only fires while the n8n
# editor is open.
#
# N8N_WEBHOOK_BASE_URL is accepted as an alias for this same setting, in case
# your n8n setup notes use that name. Only one is needed; N8N_WEBHOOK_URL
# wins if both are set.
N8N_WEBHOOK_URL=""

# Hosts a client-supplied URL may point at, comma separated. This is what makes
# the Automation Center's editable URL field safe. Leave empty to ignore client
# URLs entirely and use only N8N_WEBHOOK_URL / N8N_RULE_URLS.
#   N8N_ALLOWED_HOSTS="yourinstance.app.n8n.cloud,localhost"
N8N_ALLOWED_HOSTS=""

# Optional per-rule pinning. An entry here overrides whatever the client sends
# for that rule id — use it to lock a deployment down completely.
#   N8N_RULE_URLS={"auto_01":"https://yourinstance.app.n8n.cloud/webhook/abc"}
N8N_RULE_URLS=""

# How the dispatcher authenticates TO n8n: none | header | bearer | basic | hmac
# hmac is recommended: it signs `${timestamp}.${body}`, so a captured request
# cannot be replayed. Verify it in a Code node — and turn ON "Raw Body" in the
# n8n Webhook node, or the re-serialised body will not match the signature.
N8N_AUTH_TYPE="none"
N8N_AUTH_HEADER_NAME="X-API-Key"

# Optional credentials (only required if N8N_AUTH_TYPE is header, bearer, basic, or hmac):
# N8N_SECRET=""
# N8N_BASIC_USER=""
# N8N_BASIC_PASSWORD=""

# Firebase project id, used to VERIFY ID tokens on the dispatch endpoint.
# Verification needs only this — no service-account key — so it works on
# AI Studio's Cloud Run with nothing extra provisioned.
FIREBASE_PROJECT_ID="smart-business-automation-hub"

# Require a valid Firebase ID token on dispatch. Leave on except for local
# testing against a mock n8n.
#
# Setting this to "false" is not a small convenience. With it off the dispatch
# endpoint is unauthenticated AND the client's missing token goes unnoticed,
# because apiAuthHeader() sends no Authorization header when nobody is signed
# in to Firebase and fails silently. So a local setup can work for weeks and
# still have never once exercised the token path that production requires —
# and production cannot turn this off. Test with it ON before you deploy.
DISPATCH_REQUIRE_AUTH="true"

# ---------------------------------------------------------------------------
# Scheduled sweeps — Phase 3. These raise the time-based events a browser
# cannot: invoice_due, payment_reminder, task_overdue, sla_at_risk.
# ---------------------------------------------------------------------------

# Shared secret for POST /api/internal/sweep, which Cloud Scheduler calls.
# Unset means sweeps are DISABLED, so no scheduled reminder fires at all.
#   openssl rand -hex 32
SWEEP_TOKEN=""

# Days before the due date that invoice_due fires. Default 3.
INVOICE_REMINDER_LEAD_DAYS="3"
